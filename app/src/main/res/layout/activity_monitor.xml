<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/monitorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <ScrollView
        android:id="@+id/discoveryScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
                <TextView android:id="@+id/monitorBackButton" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="‹" android:textColor="@color/text_primary" android:textSize="34sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Parent Monitor" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold" />
                <TextView android:id="@+id/refreshButton" android:layout_width="48dp" android:layout_height="44dp" android:gravity="center" android:text="↻" android:textColor="@color/brand_dark" android:textSize="26sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Ready to connect" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Start Baby Camera on the other phone, then find it nearby." android:textColor="@color/text_secondary" android:textSize="15sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="96dp" android:layout_weight="1" android:layout_marginRight="6dp" android:background="@drawable/bg_status_good" android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/wifiReadiness" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wi‑Fi On" android:textColor="@color/success" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/wifiReadinessDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Ready for Wi‑Fi Direct" android:textColor="@color/text_secondary" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="96dp" android:layout_weight="1" android:layout_marginLeft="6dp" android:background="@drawable/bg_status_info" android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/locationReadiness" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Location On" android:textColor="@color/blue" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/locationReadinessDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Required by Android discovery" android:textColor="@color/text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/findButton" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="Scan nearby devices" />
            <TextView android:id="@+id/monitorStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Ready to scan" android:textColor="@color/text_secondary" android:textSize="14sp" />

            <LinearLayout android:id="@+id/deviceListContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
            <LinearLayout android:id="@+id/deviceListEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/emptyTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No baby camera found yet" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/emptyDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Keep Baby Camera running nearby and scan again." android:textColor="@color/text_secondary" android:textSize="14sp" />
            </LinearLayout>
            <Button android:id="@+id/monitorSettingsButton" style="@style/Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="Open settings" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/liveScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout android:id="@+id/liveHeader" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
            <TextView android:id="@+id/liveBackButton" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="‹" android:textColor="@color/text_primary" android:textSize="34sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Baby Camera" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/liveTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● LIVE · 00:00" android:textColor="@color/success" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/noiseAlertBanner" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_noise_alert" android:gravity="center_vertical" android:paddingLeft="16dp" android:text="Noise detected" android:textColor="@color/danger" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />

        <FrameLayout android:id="@+id/videoFrame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/video_bg" android:foregroundGravity="center">
            <com.localbabymonitor.app.AspectRatioSurfaceView android:id="@+id/videoSurface" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" />
            <TextView android:id="@+id/liveStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|left" android:layout_margin="12dp" android:background="@drawable/bg_overlay" android:paddingLeft="10dp" android:paddingTop="6dp" android:paddingRight="10dp" android:paddingBottom="6dp" android:text="Opening local stream…" android:textColor="#FFFFFFFF" android:textSize="12sp" />
        </FrameLayout>

        <LinearLayout android:id="@+id/liveControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/audioButton" style="@style/Button.Secondary" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginRight="4dp" android:text="Audio on" />
            <Button android:id="@+id/fullscreenButton" style="@style/Button.Secondary" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginLeft="4dp" android:text="Fullscreen" />
        </LinearLayout>

        <LinearLayout android:id="@+id/liveInfoCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Baby phone light" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/torchDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Waiting for the baby phone to report its light" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Switches the flashlight on the baby phone over the local connection. It stays on until you turn it off, and switches off if the baby phone changes camera or the stream ends." android:textColor="@color/text_secondary" android:textSize="11sp" android:lineSpacingExtra="2dp" />
            <Button android:id="@+id/torchButton" style="@style/Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:enabled="false" android:text="Turn torch on" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Noise alerts" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/noiseAlertDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="On · lock-screen notifications" android:textColor="@color/success" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/noiseThresholdLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Alert level · 16%" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" />
            <SeekBar android:id="@+id/noiseThresholdSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="16" android:max="100" android:progress="16" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lower = more sensitive. Higher = only stronger sustained sounds." android:textColor="@color/text_secondary" android:textSize="11sp" />
            <TextView android:id="@+id/noiseAlertExplanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="How it works: sustained sound events are received over the local Wi‑Fi Direct connection. Your selected level decides which events alert the parent phone." android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
            <Button android:id="@+id/noiseButton" style="@style/Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="Turn noise alerts off" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Connection · Wi‑Fi Direct" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
            <Button android:id="@+id/reconnectButton" style="@style/Button.Secondary" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="Reconnect stream" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
