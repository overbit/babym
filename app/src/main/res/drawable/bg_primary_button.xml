<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#A8D8D4"/><corners android:radius="18dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/brand_dark"/><corners android:radius="18dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/brand"/><corners android:radius="18dp"/></shape>
    </item>
</selector>
