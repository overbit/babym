        <shape android:shape="rectangle"><solid android:color="#F2F7F8"/><corners android:radius="18dp"/><stroke android:width="1dp" android:color="#CDE9E6"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/surface"/><corners android:radius="18dp"/><stroke android:width="1dp" android:color="@color/divider"/></shape>
    </item>
</selector>
