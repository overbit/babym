        <shape android:shape="rectangle"><solid android:color="#E8EDF3"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="#D7DEE8"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/surface"/><corners android:radius="16dp"/><stroke android:width="1dp" android:color="@color/divider"/></shape>
    </item>
</selector>
